# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js / build artifacts
/.next/
/.next/**
/.open-next/
out/

# Environment variables
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel
.vercel

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
logs
*.log

# Build outputs
dist/
build/

# Database
database/*.db
database/*.sqlite

# Temporary files
*.tmp
*.temp

# Tracked developer tools
!scripts/
!scripts/smoke-test.sh

# Local DB / data snapshots — never commit live customer data
/_backups/

# CSV / catalog exports for external tools (Tawk.to KB, etc.)
# Regenerate with: python3 scripts/_export-services-csv.py
/_exports/

# Service account keys and secrets
loyal-network-*.json
# Ignore all JSON except project-required ones
*.json
!package.json
!package-lock.json
!tsconfig.json
!vercel.json
!src/messages/*.json
!.eslintrc.json
# GSC indexation snapshots are coverage states only (no secrets) — keep for diffing
!scripts/gsc-snapshots/*.json
.env*.local
*gsc*.json
fotografo-gsc-*.json
