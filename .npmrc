# Cloudflare Pages' build step runs `npx @cloudflare/next-on-pages`, which is
# not a project dependency — npx resolves its peer deps (wrangler) fresh from
# the registry on every build, ignoring this project's pinned wrangler version
# entirely. @cloudflare/next-on-pages@1.13.16 peer-requires
# @cloudflare/workers-types@^4.x, but the registry's current "latest" wrangler
# now peer-requires @cloudflare/workers-types@^5.x — a hard ERESOLVE conflict
# npm can't reconcile on its own, breaking every production deploy since
# 2026-07-13 regardless of code changes. legacy-peer-deps relaxes peer
# resolution to a warning instead of a hard failure, which is the standard
# workaround for this specific upstream Cloudflare/Next.js version-drift issue.
legacy-peer-deps=true
